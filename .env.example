# PIPELINE_MAX_CHUNK_DAYS=7
# PIPELINE_CHUNK_DELAY_SECONDS=5
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=1000000
# LOG_BACKUP_COUNT=5